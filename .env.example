# Postgres connection string (Vercel Postgres, or a local Postgres for development)
DATABASE_URL="postgresql://user:password@localhost:5432/daybook"

# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""

# The main account. Data that existed before accounts were added belongs to it.
AUTH_EMAIL="you@example.com"
# Generate with: npm run hash-password -- "your-password"
# IMPORTANT: Next.js expands $VAR references in .env values, and a bcrypt
# hash is full of `$`-delimited segments (e.g. $2b$12$...) that look like
# variable names to that expander — left unescaped, most of the hash gets
# silently replaced with empty string. Escape every literal `$` as `\$`,
# e.g. "\$2b\$12\$abc...". Vitest (plain `dotenv/config`, no expansion)
# never reads this value in tests either way — see vitest.setup.ts.
AUTH_PASSWORD_HASH=""

# Optional second account with its own, separate data. Same format as above
# (escape every `$` in the hash as `\$`). Leave empty to disable it.
AUTH_EMAIL_2=""
AUTH_PASSWORD_HASH_2=""
